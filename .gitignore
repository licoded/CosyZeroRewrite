*.o
*.a
*.so
*.dylib
*.dll
*.exe

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Test output
*.log
build_fuzz/

# Logs directory (but keep the directory itself via .gitkeep)
logs/*.log
logs/*.txt
benchmark_results_*.csv
benchmark_visualization/
